# Talent with multiple professions
PREFIX pc: <https://github.com/karanbe17/film-talent-kg/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?person (COUNT(DISTINCT ?role) AS ?professions) WHERE { ?p a pc:Person; pc:name ?person; a ?role . VALUES ?role {pc:Actor pc:Director pc:CameraMan} } GROUP BY ?p ?person HAVING(COUNT(DISTINCT ?role)>1)
