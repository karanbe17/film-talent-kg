# Cast by film
PREFIX pc: <https://github.com/karanbe17/film-talent-kg/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?movie ?actor ?character ?type WHERE { ?r a pc:PerformanceRole; pc:belongsTo/pc:title ?movie; pc:filledBy/pc:name ?actor; pc:characterName ?character . OPTIONAL { ?r pc:roleType ?type } } ORDER BY ?movie ?actor
